root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{LICENSE,LICENSES/*.txt}]
trim_trailing_whitespace = false
insert_final_newline = unset
