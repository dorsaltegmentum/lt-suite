{
  "mcpServers": {
    "lt-chrome": {
      "command": "npx",
      "args": [
        "--no-workspaces",
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--autoConnect",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-category-input",
        "--no-category-network",
        "--no-category-memory",
        "--no-category-performance",
        "--no-category-emulation",
        "--redact-network-headers"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_CONFIG_DISCOVERY": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1",
        "CHROME_DEVTOOLS_MCP_CATEGORY_EXPERIMENTAL_THIRD_PARTY": ""
      },
      "excludeTools": [
        "new_page",
        "click",
        "click_at",
        "drag",
        "fill",
        "fill_form",
        "hover",
        "press_key",
        "type_text",
        "upload_file",
        "handle_dialog"
      ],
      "trust": false
    }
  }
}
